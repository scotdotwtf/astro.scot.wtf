---
interface MenuEntry {
  id: string;
  url: string;
  title: string;
}
---

<script type="module">
const menuCache = new Map();
const menuElements = new Map();
let activeMenuId = null;

function isTransparent(color) {
  return (
    !color ||
    color === 'transparent' ||
    color === 'rgba(0, 0, 0, 0)' ||
    color === 'rgba(0,0,0,0)'
  );
}

function getButtonStyles(trigger) {
  const styles = window.getComputedStyle(trigger);
  let bgcolor = styles.getPropertyValue('background-color');
  let textColor = styles.getPropertyValue('color');

  if (isTransparent(bgcolor) && trigger.parentElement) {
    const parentStyles = window.getComputedStyle(trigger.parentElement);
    const parentBg = parentStyles.getPropertyValue('background-color');
    if (!isTransparent(parentBg)) {
      bgcolor = parentBg;
    }
  }

  if (!textColor || textColor === 'transparent') {
    const parentStyles = trigger.parentElement && window.getComputedStyle(trigger.parentElement);
    if (parentStyles) {
      textColor = parentStyles.getPropertyValue('color');
    }
  }

  return {
    bgcolor: isTransparent(bgcolor) ? '#ffffff' : bgcolor,
    textColor: textColor || '#000000',
  };
}

function getThemeMeta() {
  return document.querySelector('meta[name="theme-color"]');
}

function buildMenuMarkup({ id, title, bgcolor, textColor, items }) {
  const itemMarkup = items
    .map((item) => `
      <div class="item flex flex-col p-6">
        <h1 class="text-4xl -ml-[1px]" style="color: var(--menu-text-color);">${item.title}</h1>
        <div class="flex flex-row justify-between pl-[1px]">
          <p class="text-gray-500/75">${item.alt}</p>
          <a class="underline decoration-2 underline-offset-1" href="${item.href}" style="color: var(--menu-text-color);">${item.link}</a>
        </div>
      </div>
    `)
    .join('');

  return `
    <div id="${id}" class="menu -translate-y-full fixed inset-x-0 top-0 bottom-0 flex flex-col z-20 rounded-b-4xl p-3 overflow-y-auto overscroll-contain transition-transform duration-300 ease-in-out" style="background: ${bgcolor}; --menu-text-color: ${textColor};">
      <div class="theme-color h-25 w-full -top-20 z-0 left-0 fixed" style="background: ${bgcolor};"></div>
      <div class="controls flex justify-between">
        <p class="title z-1">${title}</p>
        <button class="close bubble bg-white rounded-full z-1" type="button">close</button>
      </div>
      ${itemMarkup}
    </div>
  `;
}

function applyMenuStyles(menu, { bgcolor, textColor }) {
  if (!menu) return;
  const themeColorDiv = menu.querySelector('.theme-color');
  menu.style.background = bgcolor;
  menu.style.setProperty('--menu-text-color', textColor);
  if (themeColorDiv) {
    themeColorDiv.style.background = bgcolor;
  }
}

function ensureTopbarFill() {
  let el = document.getElementById('site-topbar-fill');
  if (el) return el;
  el = document.createElement('div');
  el.id = 'site-topbar-fill';
  el.className = 'site-topbar-fill fixed left-0 right-0 top-0 pointer-events-none';
  el.style.height = 'calc(env(safe-area-inset-top, 20px) + 12px)';
  el.style.zIndex = '30';
  el.style.background = '#ffffff';
  el.style.display = 'none'; // hidden by default, shown only when menu is open
  el.style.transition = 'background-color 300ms ease-in-out'; // smooth color transitions
  document.body.appendChild(el);
  return el;
}

function closeMenu(menu, id) {
  if (!menu) return;
  menu.classList.add('-translate-y-full');
  menu.classList.add('pointer-events-none');
  menu.setAttribute('aria-hidden', 'true');
  // animate topbar fill back to white, then hide it
  const topbar = ensureTopbarFill();
  if (topbar) {
    topbar.style.background = '#ffffff'; // animates due to transition
    setTimeout(() => {
      topbar.style.display = 'none'; // hide after color animation completes
    }, 300);
  }
  if (activeMenuId === id) {
    activeMenuId = null;
  }
  setTimeout(() => {
    getThemeMeta()?.setAttribute('content', '#ffffff');
  }, 265);
}

function openMenu(menu, id, styles) {
  menuElements.forEach((otherMenu, otherId) => {
    if (otherId !== id) {
      otherMenu.classList.add('-translate-y-full');
      otherMenu.classList.add('pointer-events-none');
      otherMenu.setAttribute('aria-hidden', 'true');
    }
  });

  applyMenuStyles(menu, styles);
  getThemeMeta()?.setAttribute('content', styles.bgcolor);
  // show and color the topbar fill so status bar area matches menu
  const topbar = ensureTopbarFill();
  if (topbar) {
    topbar.style.display = 'block'; // ensure visible so transition can apply
    topbar.style.background = styles.bgcolor;
  }

  // slide menu in (no opacity transition)
  menu.classList.remove('-translate-y-full');
  menu.classList.remove('pointer-events-none');
  menu.setAttribute('aria-hidden', 'false');
  activeMenuId = id;
}

function createMenu({ id, title, trigger, items }) {
  if (menuElements.has(id)) return menuElements.get(id);
  const { bgcolor, textColor } = getButtonStyles(trigger);
  const menuId = `${id}-menu`;
  const template = document.createElement('template');
  template.innerHTML = buildMenuMarkup({ id: menuId, title, bgcolor, textColor, items });
  const menu = template.content.firstElementChild;
  if (!menu) return null;

  menu.querySelector('.close')?.addEventListener('click', () => {
    history.replaceState(null, '', location.pathname + location.search);
    closeMenu(menu, id);
  });

  applyMenuStyles(menu, { bgcolor, textColor });
  menu.setAttribute('aria-hidden', 'true');

  document.body.append(menu);
  menuElements.set(id, menu);
  return menu;
}

function loadMenuData(trigger) {
  const id = trigger.dataset.menu;
  const url = trigger.dataset.menuUrl;
  const title = trigger.dataset.menuTitle || trigger.textContent?.trim() || id;

  if (!id || !url) {
    console.warn(`data-menu and data-menu-url are required for menu triggers.`, trigger);
    return Promise.resolve(null);
  }

  if (menuCache.has(id)) {
    return menuCache.get(id);
  }

  const promise = fetch(url)
    .then((res) => res.json())
    .then((items) => {
      const menu = createMenu({ id, title, trigger, items });
      if (location.hash === `#${id}` && menu) {
        openMenu(menu, id, getButtonStyles(trigger));
      }
      return menu;
    })
    .catch((error) => {
      menuCache.delete(id);
      console.error(`error when loading ${id}:`, error);
      return null;
    });

  menuCache.set(id, promise);
  return promise;
}

function bindTrigger(trigger) {
  const id = trigger.dataset.menu;
  if (!id) return;

  const url = trigger.dataset.menuUrl;
  if (!url) {
    console.warn(`Trigger with data-menu="${id}" is missing data-menu-url.`);
    return;
  }

  const title = trigger.dataset.menuTitle || trigger.textContent?.trim() || id;
  const menuPromise = loadMenuData(trigger);

  trigger.addEventListener('click', (event) => {
    event.preventDefault();
    if (location.hash !== `#${id}`) {
      history.pushState(null, '', `#${id}`);
    }

    menuPromise.then((menu) => {
      if (!menu) return;
      openMenu(menu, id, getButtonStyles(trigger));
    });
  });
}

function openHashMenu() {
  const hash = location.hash.slice(1);
  if (!hash) return;
  const trigger = document.querySelector(`[data-menu="${hash}"]`);
  if (!trigger) return;
  const menuPromise = loadMenuData(trigger);
  menuPromise.then((menu) => {
    if (!menu) return;
    openMenu(menu, hash, getButtonStyles(trigger));
  });
}

document.addEventListener('DOMContentLoaded', () => {
  const triggers = Array.from(document.querySelectorAll('[data-menu]'));
  triggers.forEach(bindTrigger);
  openHashMenu();
});

window.addEventListener('hashchange', openHashMenu);
</script>
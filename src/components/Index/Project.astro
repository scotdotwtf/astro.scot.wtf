---
import { Image } from 'astro:assets';

interface Props {
    image?: any;
    title: string;
    description: string;
    href?: string;
}

const { image, title, description, href = "/placeholder" } = Astro.props;

// Handle both single image and array of images
const isArray = Array.isArray(image);
const primaryImage = isArray ? image?.[0] : image;
const allImages = isArray ? image : image ? [image] : [];

const isMeta = primaryImage && typeof primaryImage === 'object';
const imageMeta = isMeta ? primaryImage : null;
const imageSrc = isMeta ? null : primaryImage;
---

<div class="Project flex flex-col gap-3">
  <a class="Project-card-link no-wiggle" href={href} data-title={title} data-description={description}>
      {imageMeta ? (
        <Image
          src={imageMeta as any}
          {...(imageMeta?.width && imageMeta?.height ? { width: imageMeta.width, height: imageMeta.height } : {})}
          class="Project-image rounded-lg aspect-square object-cover"
          alt={title}
        />
      ) : imageSrc ? (
        <img src={imageSrc} class="Project-image rounded-lg aspect-square object-cover" alt={title} />
      ) : (
        <div class="rounded-lg aspect-square bg-slate-100"></div>
      )}

      <div class="text-center pt-3">{title}</div> <!-- hidden [@media(max-width:640px)]:block -->
    </a>
</div>
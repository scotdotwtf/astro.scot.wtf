---
import { Image } from 'astro:assets';

interface Props {
    image?: any;
    title: string;
    href?: string;
}

const { image, title, href = "/placeholder" } = Astro.props;

// Handle both single image and array of images
const isArray = Array.isArray(image);
const primaryImage = isArray ? image?.[0] : image;
const allImages = isArray ? image : image ? [image] : [];

const isMeta = primaryImage && typeof primaryImage === 'object';
const imageMeta = isMeta ? primaryImage : null;
const imageSrc = isMeta ? null : primaryImage;
---

<div class="Project flex flex-col gap-3">
    <a class="Project-card-link no-wiggle" href={href}>
      {imageMeta ? (
        <Image
          src={imageMeta as any}
          {...(imageMeta?.width && imageMeta?.height ? { width: imageMeta.width, height: imageMeta.height } : {})}
          class="rounded-lg aspect-square object-cover"
          alt={title}
        />
      ) : imageSrc ? (
        <img src={imageSrc} class="rounded-lg aspect-square object-cover" alt={title} />
      ) : (
        <div class="rounded-lg aspect-square bg-slate-100"></div>
      )}

      <a class="text-center" href={href}>{title}</a>
    </a>
</div>
---
import At from '../components/Nav/At.astro'
---

<nav class="nav fixed top-0 left-0 w-full p-3 flex gap-1 z-10">
    <div class="bubble bg-gray-100 rounded-full">
        <At long="/work"  shortest="/w" href="/" />
    </div>

    <div class="bubble bg-gray-100 rounded-full">
        <At long="/about" shortest="/a" href="/about" />
    </div>
    
    <div class="bubble bg-gray-100 rounded-full">
        <At long="/blog" shortest="/b" href="https://blog.scot.wtf" /> <!-- TODO: make blog in astro LOL -->
    </div>

    <div class="grow"></div>
    
    <a data-menu="socials" data-menu-url="https://socials.scot.wtf/data.json" data-menu-title="socials" class="bubble bg-lime-100 text-black rounded-full aspect-square" href="#">@</a>
    <At long="downloadables" shortest="↓" data-menu="downloadables" data-menu-url="https://share.scot.wtf/data.json" data-menu-title="downloadables" class="bubble bg-blue-100 text-(--accent) rounded-full px-2" href="#" />
</nav>
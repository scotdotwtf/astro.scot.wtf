---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
    long: string,
    short?: string,
    shortest?: string,
    href?: string
}

const { long, short = long, shortest = short, href = "/placeholder", id, class: className, ...rest } = Astro.props;
---

<a class:list={["at", className]} href={href} {...(id && { id })} {...rest} data-long={long} data-short={short} data-shortest={shortest}>
    <span class="at-text" aria-live="polite">{long}</span>
</a>

<script>
    import { typeTo } from '../../lib/typeAnimation.js';

    if (typeof window !== 'undefined') {
        const anchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('a.at[data-long]'));
        anchors.forEach((el) => {
            if (el.dataset.atInit) return;
            el.dataset.atInit = '1';

            const long = el.dataset.long ?? '';
            const short = el.dataset.short ?? long;
            const shortest = el.dataset.shortest ?? short;
            const display = el.querySelector('.at-text');
            if (!(display instanceof HTMLElement)) return;
            const displayEl: HTMLElement = display;

            const mLarge = window.matchMedia('(min-width:460px)');
            const mSmall = window.matchMedia('(max-width:398px)');
            let cancelAnimation: () => void = () => {};

            function getTarget() {
                if (mLarge.matches) return long;
                if (mSmall.matches) return shortest;
                return short;
            }

            function updateText(target: string) {
                cancelAnimation();
                const start = displayEl.textContent ?? '';
                cancelAnimation = typeTo(displayEl, start, target, 60);
            }

            displayEl.textContent = getTarget();
            [mLarge, mSmall].forEach((mq) => mq.addEventListener('change', () => updateText(getTarget())));

            let resizeTimeout: number | null = null;
            window.addEventListener('resize', () => {
                if (resizeTimeout !== null) clearTimeout(resizeTimeout);
                resizeTimeout = window.setTimeout(() => updateText(getTarget()), 120);
            });
        });
    }
</script>

<style>
    .at-text { display: inline; }
</style>

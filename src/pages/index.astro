---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

import Project from '../components/Index/Project.astro'

const projects = await getCollection('projects');
---

<Layout>
	<div class="m-3 grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-3 animate-[grid-template-columns]">
		<!--
		<ul>
			{
				projects.map((project) => (
					<li>
						<a href={`/project/${project.id}/`}>
							{project.data.title}
						</a>
					</li>
				))
			}
		</ul>
		-->

		<!-- todo: make grid for <project> components lol -->
		{
			projects.map((project) => (
				<Project image={project.data.cover} title={project.data.title} href=`/project/${project.id}/` />
			))
		}
	</div>
</Layout>

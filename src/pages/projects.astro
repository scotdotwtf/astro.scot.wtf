        <a class="px-2! shrink-0 no-wiggle bubble rounded-full bg-red-100 text-red-500" href="#">photography</a>
        <a class="px-2! shrink-0 no-wiggle bubble rounded-full bg-blue-100 text-(--accent)" href="#">other</a>

        <div class="flex-auto"/>

        <div class="px-2! shrink-0 no-wiggle bubble bg-gray-100 rounded-full">
            <a href="#">sort ↑ </a>
        </div>
    </div>
    -->

    

    <div class="m-3 grid lg:grid-cols-3 sm:grid-cols-2 grid-cols-1 gap-3 animate-[grid-template-columns]">
        <!--
        <ul>
            {
                projects.map((project) => (
                    <li>
                        <a href={`/project/${project.id}/`}>
                            {project.data.title}
                        </a>
                    </li>
                ))
            }
        </ul>
        -->

        <!-- todo: make grid for <project> components lol -->
        {
            sortedProjects.map((project) => (
                <Project image={project.data.cover} title={project.data.title} description={project.data.description} href={`/project/${project.id}/`} />
            ))
        }
    </div>
</Layout>
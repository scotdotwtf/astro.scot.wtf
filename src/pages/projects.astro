---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

import Project from '../components/Index/Project.astro'
import Preview from '../components/Index/Preview.astro'

const projects = await getCollection('projects');

// Sort by custom order if specified, otherwise by pubDate (newest first)
const sortedProjects = projects.sort((a, b) => {
	// If both have custom order, sort by that
	if (a.data.order !== undefined && b.data.order !== undefined) {
		return a.data.order - b.data.order;
	}
	// If only one has custom order, it comes first
	if (a.data.order !== undefined) return -1;
	if (b.data.order !== undefined) return 1;
	// Otherwise sort by date (newest first)
	return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
});
---

<Layout>
    <Preview/>

    <!--
    <div class="w-full overflow-scroll text-nowrap p-3 pt-2! flex gap-1">
